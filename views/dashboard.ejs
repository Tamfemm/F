<%- include('partials/head',{title:'Model Dashboard'}) %><main class="dashboard"><p>YOUR ACCOUNT</p><h1>Model dashboard</h1><% if(!profile){ %><section class="panel"><h2>Build your profile</h2><p>Add your photos, short video, bio and contact information.</p><a class="primary inline" href="/profile/edit">Create profile</a></section><% }else{ %><section class="status <%= profile.subscriptionStatus %>"><div><small>PROFILE STATUS</small><h2><%= profile.subscriptionStatus.replace('_',' ') %></h2><p><%= profile.subscriptionStatus==='active'?'Your profile is visible and accepting bookings.':'Your information is saved, but the public profile is hidden.' %></p></div><div class="actions"><a href="/profile/edit">Edit profile</a><% if(profile.subscriptionStatus==='active'){ %><a href="/hottie/<%= profile.slug %>">View public profile</a><% }else{ %><a class="primary inline" href="/subscribe">ONLY $30/month!</a><% } %></div></section><% } %></main><%- include('partials/foot') %>
