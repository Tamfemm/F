<%- include('partials/head',{title:'Edit About Me'}) %>
<main class="formPage adminArea">
  <p>TAMARA'S ABOUT ME EDITOR</p><h1>This is your page.</h1>
  <div class="editorIntro"><b>Change it whenever you want.</b> Everything saved here appears on the public About Me page in the navigation.</div>
  <% if(error){ %><div class="error"><%= error %></div><% } %>
  <form action="/richgirlielifetammy/about-me" method="post" enctype="multipart/form-data" class="profileForm adminEditor">
    <section><h2>1. Your introduction</h2><label>Page heading<input name="pageTitle" maxlength="120" value="<%= about?.pageTitle||'About Me' %>" required></label><label>Your name<input name="displayName" maxlength="120" value="<%= about?.displayName||'Tamara' %>" required></label><label>Short introduction<input name="tagline" maxlength="300" value="<%= about?.tagline||'' %>" placeholder="A short sentence at the top of your page"></label></section>
    <section><h2>2. Your bio</h2><label>Write or update your bio<textarea class="storyText" name="bio" maxlength="12000" placeholder="Tell visitors your story in your own words..."><%= about?.bio||'' %></textarea></label></section>
    <section><h2>3. Your main bio picture</h2><% if(about?.mainImage?.url){ %><div class="currentCover"><img src="<%= about.mainImage.url %>" alt="Current About Me picture"><div><b>Current main picture</b><p>Upload another picture below whenever you want to replace it.</p></div></div><% } %><label><%= about?.mainImage?.url?'Replace my main picture':'Choose my main picture' %><input type="file" name="mainImage" accept="image/*"></label></section>
    <section><h2>4. Your gallery</h2><% if(about?.gallery?.length){ %><div class="storyAdminImages"><% about.gallery.forEach((image,index)=>{ %><label><b>Gallery picture <%= index+1 %></b><img src="<%= image.url %>" alt="Gallery picture <%= index+1 %>"><span><input type="checkbox" name="removeGallery" value="<%= image.publicId %>"> Remove this picture</span></label><% }) %></div><% } %><label>Add gallery pictures — up to 12 total<input type="file" name="gallery" accept="image/*" multiple></label></section>
    <section class="publishBox"><h2>5. Save it</h2><div class="editorButtons"><button class="primary">Save my About Me page</button><a href="/richgirlielifetammy/admin">Cancel</a></div></section>
  </form>
</main>
<%- include('partials/foot') %>
