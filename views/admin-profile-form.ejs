<%- include('partials/head',{title:profile?'Edit Profile':'Create Profile'}) %>
<main class="formPage adminArea">
  <p>TAMARA'S EASY EDITOR</p><h1><%= profile?'Update her page.':'Create her profile.' %></h1>
  <div class="editorIntro"><b>You control everything here.</b> Change the bio, replace the main profile picture, manage the gallery, and publish whenever it is ready.</div>
  <% if(error){ %><div class="error"><%= error %></div><% } %>
  <form action="<%= action %>" method="post" enctype="multipart/form-data" class="profileForm adminEditor">
    <section><h2>1. The basics</h2><div class="formGrid"><label>Model's name<input name="name" value="<%= profile?.name||'' %>" required></label><label>City<input name="city" value="<%= profile?.city||'' %>" required></label><label>State<input name="state" value="<%= profile?.state||'' %>" required></label><label>Public email<input type="email" name="email" value="<%= profile?.email||'' %>" required></label><label>Public phone<input name="phone" value="<%= profile?.phone||'' %>" required></label><label>Age<input type="number" name="age" min="18" max="99" value="<%= profile?.age||'' %>" required></label></div></section>
    <section><h2>2. Her bio</h2><label>Bio / little story<textarea name="bio" maxlength="1200" placeholder="Write about her personality, style and the kind of work she is available for..."><%= profile?.bio||'' %></textarea></label><label>Available to<input name="availableTo" placeholder="Travel, shoots, events..." value="<%= profile?.availableTo||'' %>"></label></section>
    <section><h2>3. Her details</h2><div class="formGrid"><label>Nationality<input name="nationality" value="<%= profile?.nationality||'' %>"></label><label>Height<input name="height" value="<%= profile?.height||'' %>"></label><label>Weight<input name="weight" value="<%= profile?.weight||'' %>"></label><label>Eye color<input name="eyeColor" value="<%= profile?.eyeColor||'' %>"></label><label>Hair color<input name="hairColor" value="<%= profile?.hairColor||'' %>"></label><label>Measurements<input name="measurements" value="<%= profile?.measurements||'' %>"></label></div></section>
    <section><h2>4. Main bio/profile picture</h2><% if(profile?.photos?.[0]){ %><div class="currentCover"><img src="<%= profile.photos[0].url %>" alt="Current main profile picture"><div><b>Current main picture</b><p>This is the picture shown first on her profile and on the city listing card.</p></div></div><% } %><label><%= profile?.photos?.length?'Replace the main picture':'Choose the main profile picture' %><input type="file" name="coverPhoto" accept="image/*"></label><small class="fieldHelp">Uploading a replacement makes it the new main picture automatically.</small></section>
    <section><h2>5. Gallery pictures</h2><% if(profile?.photos?.length){ %><p class="fieldHelp">You can make any existing picture the main one or remove pictures she no longer wants.</p><div class="adminPhotos"><% profile.photos.forEach((photo,index)=>{ %><label><img src="<%= photo.url %>" alt="Current profile photo"><span><input type="radio" name="featuredPhoto" value="<%= photo.publicId %>" <%= index===0?'checked':'' %>> Use as main picture</span><span><input type="checkbox" name="removePhotos" value="<%= photo.publicId %>"> Remove from gallery</span></label><% }) %></div><% } %><label>Add gallery pictures — maximum 10 pictures total<input type="file" name="photos" accept="image/*" multiple></label></section>
    <section><h2>6. Short video</h2><% if(profile?.video?.url){ %><video class="adminCurrentVideo" controls preload="metadata" src="<%= profile.video.url %>"></video><% } %><label><%= profile?.video?.url?'Replace the 3-second video':'Add a 3-second video' %><input id="videoInput" type="file" name="video" accept="video/*"></label></section>
    <section class="publishBox"><h2>7. Save it</h2><label>Should visitors see this profile now?<select name="subscriptionStatus"><option value="draft" <%= profile?.subscriptionStatus!=='active'?'selected':'' %>>Keep it as a draft — hidden</option><option value="active" <%= profile?.subscriptionStatus==='active'?'selected':'' %>>Publish it — visible now</option></select></label><div class="editorButtons"><button class="primary">Save all changes</button><a href="/richgirlielifetammy/admin">Cancel</a></div></section>
  </form>
</main>
<%- include('partials/foot') %>
