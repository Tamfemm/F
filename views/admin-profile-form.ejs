<%- include('partials/head',{title:profile?'Edit Profile':'Create Profile'}) %><main class="formPage adminArea"><p>TAMARA'S EASY EDITOR</p><h1><%= profile?'Edit her story.':'Create her profile.' %></h1><div class="editorIntro"><b>Nothing technical here.</b> Fill in what you know, add the pictures, then choose Draft or Published.</div><% if(error){ %><div class="error"><%= error %></div><% } %><form action="<%= action %>" method="post" enctype="multipart/form-data" class="profileForm adminEditor"><section><h2>1. The basics</h2><div class="formGrid"><label>Model's name<input name="name" value="<%= profile?.name||'' %>" required></label><label>City<input name="city" value="<%= profile?.city||'' %>" required></label><label>State<input name="state" value="<%= profile?.state||'' %>" required></label><label>Public email<input type="email" name="email" value="<%= profile?.email||'' %>" required></label><label>Public phone<input name="phone" value="<%= profile?.phone||'' %>" required></label><label>Age<input type="number" name="age" min="18" max="99" value="<%= profile?.age||'' %>" required></label></div></section><section><h2>2. Her story</h2><label>Bio / little story<textarea name="bio" maxlength="1200" placeholder="Tell visitors about her, her personality and what kind of work she is available for..."><%= profile?.bio||'' %></textarea></label><label>Available to<input name="availableTo" placeholder="Travel, shoots, events..." value="<%= profile?.availableTo||'' %>"></label></section><section><h2>3. Her details</h2><div class="formGrid"><label>Nationality<input name="nationality" value="<%= profile?.nationality||'' %>"></label><label>Height<input name="height" value="<%= profile?.height||'' %>"></label><label>Weight<input name="weight" value="<%= profile?.weight||'' %>"></label><label>Eye color<input name="eyeColor" value="<%= profile?.eyeColor||'' %>"></label><label>Hair color<input name="hairColor" value="<%= profile?.hairColor||'' %>"></label><label>Measurements<input name="measurements" value="<%= profile?.measurements||'' %>"></label></div></section><section><h2>4. Pictures and video</h2><% if(profile?.photos?.length){ %><div class="adminPhotos"><% profile.photos.forEach(photo=>{ %><label><img src="<%= photo.url %>" alt="Current profile photo"><span><input type="checkbox" name="removePhotos" value="<%= photo.publicId %>"> Remove this picture</span></label><% }) %></div><% } %><label>Add pictures — maximum 10 total<input type="file" name="photos" accept="image/*" multiple></label><label>Add or replace the 3-second video<input id="videoInput" type="file" name="video" accept="video/*"></label></section><section class="publishBox"><h2>5. Save it</h2><label>Should visitors see this profile now?<select name="subscriptionStatus"><option value="draft" <%= profile?.subscriptionStatus!=='active'?'selected':'' %>>Keep it as a draft — hidden</option><option value="active" <%= profile?.subscriptionStatus==='active'?'selected':'' %>>Publish it — visible now</option></select></label><div class="editorButtons"><button class="primary">Save profile</button><a href="/richgirlielifetammy/admin">Cancel</a></div></section></form></main><%- include('partials/foot') %>
