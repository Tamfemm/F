<%- include('partials/head',{title:'Stories | Tfem Hotties'}) %><main class="storiesPage"><section class="storiesHero"><p>TFEM STORIES</p><h1>Little stories.<br><em>Big personality.</em></h1><span>Cartoons, moments and adventures from Tfem Hotties.</span></section><section class="storyGrid"><% if(!stories.length){ %><div class="storyEmpty"><h2>Stories are coming soon.</h2><p>Check back for Tamara's first cartoon strip and story.</p></div><% } stories.forEach(story=>{ %><a class="storyCard" href="/stories/<%= story.slug %>"><% if(story.images?.[0]){ %><img src="<%= story.images[0].url %>" alt="<%= story.title %>"><% }else{ %><div class="storyPlaceholder">♥</div><% } %><div><small><%= new Date(story.publishedAt||story.createdAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></small><h2><%= story.title %></h2><p><%= story.excerpt||'Read the full story.' %></p><b>Read story →</b></div></a><% }) %></section></main><%- include('partials/foot') %>
