<%- include('partials/head',{title:`${profile.name} | TG Hotties`}) %><main><section class="profileTop"><div><p>TG HOTTIE · <%= profile.city.toUpperCase() %></p><h1><%= profile.name %></h1><span>Available for bookings</span></div><div class="contact"><small>CONTACT <%= profile.name.toUpperCase() %></small><a href="tel:<%= profile.phone %>"><%= profile.phone %></a><a href="mailto:<%= profile.email %>"><%= profile.email %></a></div></section><section class="detail"><div class="gallery"><% profile.photos.forEach((photo,i)=>{ %><button data-photo="<%= photo.url %>" data-index="<%= i %>"><img src="<%= photo.url %>" alt="<%= profile.name %> photo <%= i+1 %>"></button><% }) %></div><aside><% if(profile.video?.url){ %><video controls preload="metadata" src="<%= profile.video.url %>"></video><% } %><div class="bio"><small>ABOUT ME</small><h2>Hi, I'm <%= profile.name %>.</h2><p><%= profile.bio %></p><dl><% [['Nationality',profile.nationality],['Height',profile.height],['Weight',profile.weight],['Eye color',profile.eyeColor],['Hair color',profile.hairColor],['Measurements',profile.measurements],['Age',profile.age],['Available to',profile.availableTo]].forEach(([k,v])=>{if(v){ %><div><dt><%= k %></dt><dd><%= v %></dd></div><% }}) %></dl></div></aside></section><div id="lightbox" class="lightbox hidden"><button id="close">×</button><button id="prev">‹</button><img id="largePhoto" alt="Enlarged model photo"><button id="next">›</button></div></main><%- include('partials/foot') %>
