<%- include('partials/head',{title:story?'Edit Story':'Create Story'}) %>
<main class="formPage adminArea">
  <p>TAMARA'S STORY EDITOR</p><h1><%= story?'Edit your story.':'Tell your story.' %></h1>
  <div class="editorIntro"><b>Perfect for AI cartoon strips.</b> Select the images in the order readers should see them. New images are added after the ones already here.</div>
  <% if(error){ %><div class="error"><%= error %></div><% } %>
  <form action="<%= action %>" method="post" enctype="multipart/form-data" class="profileForm adminEditor">
    <section><h2>1. Give it a title</h2><label>Story title<input name="title" maxlength="160" value="<%= story?.title||'' %>" placeholder="The day everything went pink..." required></label><label>Short preview<textarea class="shortText" name="excerpt" maxlength="350" placeholder="A short sentence visitors see before opening the story."><%= story?.excerpt||'' %></textarea></label></section>
    <section><h2>2. Write the story</h2><label>Full story<textarea class="storyText" name="body" maxlength="12000" placeholder="Write naturally. Your paragraphs and line breaks will be preserved."><%= story?.body||'' %></textarea></label></section>
    <section><h2>3. Add and arrange the cartoon or pictures</h2><p class="fieldHelp">Use the arrows to put every picture in the exact reading order you want. “Remove this image” takes it out of the editor immediately. Save or publish when finished.</p><input type="hidden" id="imageOrder" name="imageOrder"><div class="storyOrderGrid" id="storyImageOrder"><% (story?.images||[]).forEach((image,index)=>{ %><article class="storyOrderItem" data-image-key="old:<%= image.publicId %>"><b class="storyOrderNumber">Image <%= index+1 %></b><img src="<%= image.url %>" alt="Story image <%= index+1 %>"><div><button type="button" data-move="left" aria-label="Move image left">← Earlier</button><button type="button" data-move="right" aria-label="Move image right">Later →</button></div><button type="button" class="removeStoryImage" data-remove-story-image>Remove this image</button></article><% }) %></div><label>Add images — up to 12 total<input id="storyImages" type="file" name="images" accept="image/*" multiple></label><small class="fieldHelp">New pictures appear in the editor immediately so you can arrange them before saving.</small></section>
    <section class="publishBox"><h2>4. Save or publish</h2><p class="fieldHelp">A draft stays safely in your private Draft Stories section. Publishing makes the story visible to everyone immediately.</p><div class="storySaveChoices"><button class="draftButton" type="submit" name="status" value="draft">Save Draft</button><button class="primary publishStoryButton" type="submit" name="status" value="published"><%= story?.status==='published'?'Update Published Story':'Publish Story' %></button><a href="/richgirlielifetammy/admin">Cancel</a></div></section>
  </form>
</main>
<%- include('partials/foot') %>
