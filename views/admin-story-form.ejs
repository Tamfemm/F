<%- include('partials/head',{title:story?'Edit Story':'Create Story'}) %>
<main class="formPage adminArea">
  <p>TAMARA'S STORY EDITOR</p><h1><%= story?'Edit your story.':'Tell your story.' %></h1>
  <div class="editorIntro"><b>Perfect for AI cartoon strips.</b> Select the images in the order readers should see them. New images are added after the ones already here.</div>
  <% if(error){ %><div class="error"><%= error %></div><% } %>
  <form action="<%= action %>" method="post" enctype="multipart/form-data" class="profileForm adminEditor">
    <section><h2>1. Give it a title</h2><label>Story title<input name="title" maxlength="160" value="<%= story?.title||'' %>" placeholder="The day everything went pink..." required></label><label>Short preview<textarea class="shortText" name="excerpt" maxlength="350" placeholder="A short sentence visitors see before opening the story."><%= story?.excerpt||'' %></textarea></label></section>
    <section><h2>2. Write the story</h2><label>Full story<textarea class="storyText" name="body" maxlength="12000" placeholder="Write naturally. Your paragraphs and line breaks will be preserved."><%= story?.body||'' %></textarea></label></section>
    <section><h2>3. Add the cartoon or pictures</h2><% if(story?.images?.length){ %><p class="fieldHelp">Current reading order:</p><div class="storyAdminImages"><% story.images.forEach((image,index)=>{ %><label><b>Image <%= index+1 %></b><img src="<%= image.url %>" alt="Story image <%= index+1 %>"><span><input type="checkbox" name="removeImages" value="<%= image.publicId %>"> Remove this image</span></label><% }) %></div><% } %><label>Add images — up to 12 total<input type="file" name="images" accept="image/*" multiple></label><small class="fieldHelp">Tip: when choosing several files, select them in the same order as the cartoon panels.</small></section>
    <section class="publishBox"><h2>4. Save it</h2><label>Should visitors see this story now?<select name="status"><option value="draft" <%= story?.status!=='published'?'selected':'' %>>Keep it as a draft — hidden</option><option value="published" <%= story?.status==='published'?'selected':'' %>>Publish it — visible now</option></select></label><div class="editorButtons"><button class="primary">Save story</button><a href="/richgirlielifetammy/admin">Cancel</a></div></section>
  </form>
</main>
<%- include('partials/foot') %>
