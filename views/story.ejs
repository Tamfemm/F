<%- include('partials/head',{title:`${story.title} | TG Stories`}) %><main class="storyPage"><header><p>TG STORY</p><h1><%= story.title %></h1><span><%= new Date(story.publishedAt||story.createdAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span></header><article><% if(story.excerpt){ %><p class="storyLead"><%= story.excerpt %></p><% } %><div class="storyBody"><%= story.body||'' %></div><% if(story.images?.length){ %><div class="comicStrip"><% story.images.forEach((image,index)=>{ %><button data-photo="<%= image.url %>" aria-label="Enlarge story image <%= index+1 %>"><img src="<%= image.url %>" alt="<%= story.title %> — image <%= index+1 %>"></button><% }) %></div><% } %><a class="backStories" href="/stories">← Back to all stories</a></article><div id="lightbox" class="lightbox hidden"><button id="close">×</button><button id="prev">‹</button><img id="largePhoto" alt="Enlarged story image"><button id="next">›</button></div></main><%- include('partials/foot') %>
