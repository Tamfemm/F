<%- include('partials/head',{title:`${about.pageTitle||'About Me'} | Tfem Hotties`}) %>
<main class="aboutPage">
  <section class="aboutHero"><div><p>MEET THE WOMAN BEHIND TFEM</p><h1><%= about.pageTitle||'About Me' %></h1><span><%= about.tagline||'' %></span></div><% if(about.mainImage?.url){ %><img src="<%= about.mainImage.url %>" alt="<%= about.displayName||'Tamara' %>"><% }else{ %><div class="aboutPhotoPlaceholder">♥</div><% } %></section>
  <section class="aboutContent"><div class="aboutCopy"><small>HELLO, I'M</small><h2><%= about.displayName||'Tamara' %></h2><div><%= about.bio||'My story is coming soon.' %></div></div><% if(about.gallery?.length){ %><div class="aboutGallery"><h2>My gallery</h2><div><% about.gallery.forEach((image,index)=>{ %><button data-photo="<%= image.url %>" aria-label="Enlarge gallery image <%= index+1 %>"><img src="<%= image.url %>" alt="<%= about.displayName||'Tamara' %> gallery image <%= index+1 %>"></button><% }) %></div></div><% } %></section>
  <div id="lightbox" class="lightbox hidden"><button id="close">×</button><button id="prev">‹</button><img id="largePhoto" alt="Enlarged gallery image"><button id="next">›</button></div>
</main>
<%- include('partials/foot') %>
