<%- include('partials/head',{title:'Edit Model Profile'}) %><main class="formPage"><p>YOUR PUBLIC PROFILE</p><h1>Show them who you are.</h1><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" enctype="multipart/form-data" class="profileForm"><div class="formGrid"><label>Name<input name="name" value="<%= profile?.name||'' %>" required></label><label>Public email<input type="email" name="email" value="<%= profile?.email||'' %>" required></label><label>Public phone<input name="phone" value="<%= profile?.phone||'' %>" required></label><label>City<input name="city" value="<%= profile?.city||'' %>" required></label><label>State<input name="state" value="<%= profile?.state||'' %>" required></label><label>Nationality<input name="nationality" value="<%= profile?.nationality||'' %>"></label><label>Height<input name="height" value="<%= profile?.height||'' %>"></label><label>Weight<input name="weight" value="<%= profile?.weight||'' %>"></label><label>Eye color<input name="eyeColor" value="<%= profile?.eyeColor||'' %>"></label><label>Hair color<input name="hairColor" value="<%= profile?.hairColor||'' %>"></label><label>Measurements<input name="measurements" value="<%= profile?.measurements||'' %>"></label><label>Age<input type="number" name="age" min="18" max="99" value="<%= profile?.age||'' %>" required></label><label class="wide">Available to<input name="availableTo" placeholder="Travel, shoots, events..." value="<%= profile?.availableTo||'' %>"></label><label class="wide">Bio<textarea name="bio" maxlength="1200"><%= profile?.bio||'' %></textarea></label><label class="wide">Photos — up to 10<input type="file" name="photos" accept="image/*" multiple></label><label class="wide">3-second video<input id="videoInput" type="file" name="video" accept="video/*"></label></div><button class="primary">Save and continue</button></form></main><%- include('partials/foot') %>
