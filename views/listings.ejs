<%- include('partials/head',{title:`Tfem Hotties ${city}`}) %><main><section class="listingHero"><%- include('partials/greeting-podium',{about}) %><p>LOCAL MODEL DIRECTORY</p><h1>Tfem Hotties <em><%= city %></em></h1><span>Browse hotties available in <%= city %>, <%= state %>.</span></section><section class="cards"><% profiles.forEach(p=>{ %><a class="card" href="/hottie/<%= p.slug %>"><% if(p.photos[0]){ %><img src="<%= p.photos[0].url %>" alt="<%= p.name %>"><% }else{ %><div class="placeholder"><%= p.name.slice(0,2) %></div><% } %><h2><%= p.name %><% if(p.isDemo){ %> <small>DEMO</small><% } %></h2><p><%= p.city %> · View profile</p></a><% }) %><% if(!profiles.length){ %><p>No active profiles are currently available here.</p><% } %></section></main><%- include('partials/foot') %>
