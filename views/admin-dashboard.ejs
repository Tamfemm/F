<%- include('partials/head',{title:"Tamara's Admin"}) %>
<main class="dashboard adminArea">
  <div class="adminWelcome">
    <div><p>TAMARA'S ADMIN</p><h1>Your creative studio.</h1><span>Profiles, stories, cartoons and payments—without touching any code.</span></div>
    <div class="adminTopActions"><a class="primary" href="/richgirlielifetammy/about-me">Edit My About Page</a><a class="primary" href="/richgirlielifetammy/profiles/new">+ Create profile</a><a class="primary blueButton" href="/richgirlielifetammy/stories/new">+ Create story</a><form action="/richgirlielifetammy/logout" method="post"><button>Log out</button></form></div>
  </div>
  <section class="adminStats">
    <div><small>TOTAL PROFILES</small><strong><%= profiles.length %></strong></div>
    <div><small>PUBLISHED STORIES</small><strong><%= stories.filter(story=>story.status==='published').length %></strong></div>
    <div><small>ACTIVE STRIPE SUBSCRIPTIONS</small><strong><%= stripeSummary.connected?stripeSummary.activeSubscriptions:'—' %></strong></div>
    <div><small>RECENT PAYMENTS</small><strong><%= stripeSummary.connected?`${stripeSummary.currency} $${stripeSummary.revenue.toFixed(2)}`:'Not connected' %></strong></div>
  </section>
  <section class="adminPanel aboutAdminCallout"><div><small>YOUR PERSONAL PAGE</small><h2>About Me, bio picture & gallery</h2><p>Update your personal bio, replace your main picture, and manage your gallery whenever you want.</p></div><a class="primary" href="/richgirlielifetammy/about-me">Edit My About Page</a></section>
  <section class="adminPanel storyLibrary">
    <div class="sectionHead"><h2>My Story Library</h2><small>Drafts stay private until you publish them</small></div>
    <% if(storySaved){ %><div class="saveConfirmation"><b><%= storySaved==='published'?'Your story is published!':'Your draft is saved!' %></b><span><%= storySaved==='published'?'Visitors can now read it on the Stories page.':'It is safe below in Draft Stories. You can return and finish it anytime.' %></span></div><% } %>
    <div class="storyAdminColumns">
      <section id="draft-stories" class="storyShelf draftShelf"><div class="storyShelfHead"><div><small>PRIVATE</small><h3>Draft Stories</h3></div><strong><%= draftStories.length %></strong></div><% if(!draftStories.length){ %><div class="shelfEmpty">You have no drafts right now.</div><% } %><div class="storyAdminList"><% draftStories.forEach(story=>{ %><article><% if(story.images?.[0]){ %><img src="<%= story.images[0].url %>" alt=""><% }else{ %><div class="storyMiniPlaceholder">♥</div><% } %><div class="storyAdminInfo"><b><%= story.title %></b><small>Saved <%= new Date(story.updatedAt||story.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></small><p><%= story.excerpt||'No preview written yet.' %></p><div class="storyItemActions"><a href="/richgirlielifetammy/stories/<%= story._id %>/edit">Continue editing</a><form action="/richgirlielifetammy/stories/<%= story._id %>/status" method="post"><input type="hidden" name="status" value="published"><button class="publish">Publish</button></form></div></div></article><% }) %></div></section>
      <section id="published-stories" class="storyShelf publishedShelf"><div class="storyShelfHead"><div><small>VISIBLE TO EVERYONE</small><h3>Published Stories</h3></div><strong><%= publishedStories.length %></strong></div><% if(!publishedStories.length){ %><div class="shelfEmpty">You have not published a story yet.</div><% } %><div class="storyAdminList"><% publishedStories.forEach(story=>{ %><article><% if(story.images?.[0]){ %><img src="<%= story.images[0].url %>" alt=""><% }else{ %><div class="storyMiniPlaceholder">♥</div><% } %><div class="storyAdminInfo"><b><%= story.title %></b><small>Published <%= new Date(story.publishedAt||story.updatedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></small><p><%= story.excerpt||'No preview written yet.' %></p><div class="storyItemActions"><a href="/richgirlielifetammy/stories/<%= story._id %>/edit">Edit</a><a href="/stories/<%= story.slug %>">View live</a><form action="/richgirlielifetammy/stories/<%= story._id %>/status" method="post"><input type="hidden" name="status" value="draft"><button>Move to drafts</button></form></div></div></article><% }) %></div></section>
    </div>
  </section>
  <section class="adminPanel">
    <div class="sectionHead"><h2>Model profiles</h2><small>Draft profiles are hidden from visitors</small></div>
    <div class="adminProfiles"><% if(!profiles.length){ %><p>No profiles yet. Click “Create profile” to make the first one.</p><% } profiles.forEach(profile=>{ %><article><div><b><%= profile.name %></b><span><%= profile.city %>, <%= profile.state %></span><small class="badge <%= profile.subscriptionStatus %>"><%= profile.subscriptionStatus.replace('_',' ') %></small></div><div class="rowActions"><a href="/richgirlielifetammy/profiles/<%= profile._id %>/edit">Edit everything</a><% if(profile.subscriptionStatus==='active'){ %><a href="/hottie/<%= profile.slug %>">View live page</a><form action="/richgirlielifetammy/profiles/<%= profile._id %>/status" method="post"><input type="hidden" name="status" value="draft"><button>Hide</button></form><% }else{ %><form action="/richgirlielifetammy/profiles/<%= profile._id %>/status" method="post"><input type="hidden" name="status" value="active"><button class="publish">Publish</button></form><% } %></div></article><% }) %></div>
  </section>
  <section class="adminPanel">
    <div class="sectionHead"><h2>Stripe payments</h2><small>Only Tfem activity from your connected account</small></div>
    <% if(stripeSummary.error){ %><div class="error"><%= stripeSummary.error %></div><% }else if(!stripeSummary.connected){ %><p>Add your real Stripe secret key to see payments here.</p><% }else if(!payments.length){ %><p>No Tfem Stripe payments yet.</p><% }else{ %><div class="payments"><% payments.forEach(payment=>{ %><div><span><%= payment.date.toLocaleDateString('en-US') %></span><b><%= payment.email %></b><span><%= payment.currency %> $<%= payment.amount.toFixed(2) %></span><small><%= payment.status %></small></div><% }) %></div><p class="adminNote">Full refunds, disputes and payouts remain available in your Stripe Dashboard.</p><% } %>
  </section>
</main>
<%- include('partials/foot') %>
