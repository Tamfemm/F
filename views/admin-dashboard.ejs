<%- include('partials/head',{title:"Tamara's Admin"}) %>
<main class="dashboard adminArea">
  <div class="adminWelcome">
    <div><p>TAMARA'S ADMIN</p><h1>Your creative studio.</h1><span>Profiles, stories, cartoons and payments—without touching any code.</span></div>
    <div class="adminTopActions"><a class="primary" href="/richgirlielifetammy/profiles/new">+ Create profile</a><a class="primary blueButton" href="/richgirlielifetammy/stories/new">+ Create story</a><form action="/richgirlielifetammy/logout" method="post"><button>Log out</button></form></div>
  </div>
  <section class="adminStats">
    <div><small>TOTAL PROFILES</small><strong><%= profiles.length %></strong></div>
    <div><small>PUBLISHED STORIES</small><strong><%= stories.filter(story=>story.status==='published').length %></strong></div>
    <div><small>ACTIVE STRIPE SUBSCRIPTIONS</small><strong><%= stripeSummary.connected?stripeSummary.activeSubscriptions:'—' %></strong></div>
    <div><small>RECENT PAYMENTS</small><strong><%= stripeSummary.connected?`${stripeSummary.currency} $${stripeSummary.revenue.toFixed(2)}`:'Not connected' %></strong></div>
  </section>
  <section class="adminPanel">
    <div class="sectionHead"><h2>Stories & cartoon strips</h2><small>Upload the images in reading order</small></div>
    <div class="adminProfiles"><% if(!stories.length){ %><p>No stories yet. Click “Create story” to make the first one.</p><% } stories.forEach(story=>{ %><article><div><b><%= story.title %></b><span><%= story.images.length %> image<%= story.images.length===1?'':'s' %></span><small class="badge <%= story.status==='published'?'active':'' %>"><%= story.status %></small></div><div class="rowActions"><a href="/richgirlielifetammy/stories/<%= story._id %>/edit">Edit story</a><% if(story.status==='published'){ %><a href="/stories/<%= story.slug %>">View live story</a><form action="/richgirlielifetammy/stories/<%= story._id %>/status" method="post"><input type="hidden" name="status" value="draft"><button>Hide</button></form><% }else{ %><form action="/richgirlielifetammy/stories/<%= story._id %>/status" method="post"><input type="hidden" name="status" value="published"><button class="publish">Publish</button></form><% } %></div></article><% }) %></div>
  </section>
  <section class="adminPanel">
    <div class="sectionHead"><h2>Model profiles</h2><small>Draft profiles are hidden from visitors</small></div>
    <div class="adminProfiles"><% if(!profiles.length){ %><p>No profiles yet. Click “Create profile” to make the first one.</p><% } profiles.forEach(profile=>{ %><article><div><b><%= profile.name %></b><span><%= profile.city %>, <%= profile.state %></span><small class="badge <%= profile.subscriptionStatus %>"><%= profile.subscriptionStatus.replace('_',' ') %></small></div><div class="rowActions"><a href="/richgirlielifetammy/profiles/<%= profile._id %>/edit">Edit everything</a><% if(profile.subscriptionStatus==='active'){ %><a href="/hottie/<%= profile.slug %>">View live page</a><form action="/richgirlielifetammy/profiles/<%= profile._id %>/status" method="post"><input type="hidden" name="status" value="draft"><button>Hide</button></form><% }else{ %><form action="/richgirlielifetammy/profiles/<%= profile._id %>/status" method="post"><input type="hidden" name="status" value="active"><button class="publish">Publish</button></form><% } %></div></article><% }) %></div>
  </section>
  <section class="adminPanel">
    <div class="sectionHead"><h2>Stripe payments</h2><small>Only Tfem activity from your connected account</small></div>
    <% if(stripeSummary.error){ %><div class="error"><%= stripeSummary.error %></div><% }else if(!stripeSummary.connected){ %><p>Add your real Stripe secret key to see payments here.</p><% }else if(!payments.length){ %><p>No Tfem Stripe payments yet.</p><% }else{ %><div class="payments"><% payments.forEach(payment=>{ %><div><span><%= payment.date.toLocaleDateString('en-US') %></span><b><%= payment.email %></b><span><%= payment.currency %> $<%= payment.amount.toFixed(2) %></span><small><%= payment.status %></small></div><% }) %></div><p class="adminNote">Full refunds, disputes and payouts remain available in your Stripe Dashboard.</p><% } %>
  </section>
</main>
<%- include('partials/foot') %>
