<%- include('partials/head',{title:'Tfem Hotties | Find Models'}) %><main><section class="hero"><%- include('partials/greeting-podium',{about}) %><p>FIND TFEM HOTTIES ACROSS THE USA</p><h1>Find your city.<br><em>Meet local hotties.</em></h1><label>What city are you looking for?</label><div class="search"><input id="citySearch" placeholder="Start typing a city..." autocomplete="off"><div id="suggestions"></div></div></section><section class="directory"><div class="sectionHead"><h2>Browse hotties across the USA</h2><small>Choose a state, then select your city</small></div><div class="stateGrid"><% states.forEach(({state,cities},i)=>{ %><details class="state <%= i%2?'blue':'pink' %>"><summary><%= state %></summary><div class="cityList"><% cities.forEach(city=>{ %><a href="/models/<%= encodeURIComponent(state) %>/<%= encodeURIComponent(city) %>"><%= city %></a><% }) %></div></details><% }) %></div><% if(locations.length){ %><div class="sectionHead activeHead"><h2>Recently active cities</h2><small>Profiles currently live</small></div><div class="locations"><% locations.forEach(({_id,count},i)=>{ %><a class="<%= i%2?'blue':'pink' %>" href="/models/<%= encodeURIComponent(_id.state) %>/<%= encodeURIComponent(_id.city) %>"><b><%= _id.city %></b><span><%= _id.state %> · <%= count %></span></a><% }) %></div><% } %></section></main><%- include('partials/foot') %>
